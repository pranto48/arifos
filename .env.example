# LifeOS Docker defaults
# Copy to .env before first run: cp .env.example .env

# ----------------------------------------------------------------------------
# Runtime profile selection
# ----------------------------------------------------------------------------
# Use `dev` for local iteration and `prod` for persistent deployments.
# Override in command line if needed: docker compose --profile prod up -d
COMPOSE_PROFILES=prod

# ----------------------------------------------------------------------------
# Public app access
# ----------------------------------------------------------------------------
APP_PORT=3377
HTTPS_PORT=3378
LIFEOS_URL=http://localhost:3377

# ----------------------------------------------------------------------------
# Database (required secrets: POSTGRES_PASSWORD)
# ----------------------------------------------------------------------------
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me-strong-db-password

# ----------------------------------------------------------------------------
# Backend security (required secret: JWT_SECRET)
# ----------------------------------------------------------------------------
JWT_SECRET=change-me-long-random-jwt-secret
LICENSE_API_URL=https://abcytwvuntyicdknpzju.supabase.co/functions/v1/verify-license

# ----------------------------------------------------------------------------
# Optional first-run automation
# ----------------------------------------------------------------------------
# If set, wizard can auto-bootstrap admin user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional license activation key
APP_LICENSE_KEY=
